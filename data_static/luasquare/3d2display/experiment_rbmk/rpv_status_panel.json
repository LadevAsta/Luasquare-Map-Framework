{
  "schema": "luasquare.3d2display/v1", "id": "rpv_status_panel", "buildMode": "simple",
  "target": "tar_display_rpv", "unitWidth": 34, "unitHeight": 53, "scale": 0.1,
  "title": "RPV STATUS", "themeGroup": "rbmk", "padding": 10, "lineHeight": 18, "titleHeight": 28,
  "lines": [
    {"type": "value", "label": "MWth", "value": {"provider": "reference", "path": "thermalMW"}, "decimals": 0},
    {"type": "value", "label": "RPV Pressure", "value": {"provider": "reference", "path": "RPVPressure"}, "decimals": 1, "unit": "bar", "warn": {"provider": "reference", "path": "pressureWarn"}},
    {"type": "bar", "fraction": {"provider": "reference", "path": "pressureFraction"}, "height": 5},
    {"type": "bar", "label": "Core Hold-up", "fraction": {"provider": "reference", "path": "waterFraction"}, "height": 5},
    {"type": "value", "label": "Core Flow", "value": {"provider": "reference", "path": "LastEffectiveCoreFlow"}, "decimals": 0, "unit": "/s", "warn": {"provider": "reference", "path": "dryoutWarn"}},
    {"type": "value", "label": "Natural Flow", "value": {"provider": "reference", "path": "LastNaturalCirculationFlow"}, "decimals": 0, "unit": "/s"},
    {"type": "value", "label": "Quality", "value": {"provider": "reference", "path": "qualityPercent"}, "decimals": 1, "unit": "%"},
    {"type": "value", "label": "Void", "value": {"provider": "reference", "path": "voidPercent"}, "decimals": 1, "unit": "%"},
    {"type": "bar", "label": "Dryout Risk", "fraction": {"provider": "reference", "path": "LastDryoutRisk"}, "height": 5, "warn": {"provider": "reference", "path": "dryoutWarn"}}
  ]
}
