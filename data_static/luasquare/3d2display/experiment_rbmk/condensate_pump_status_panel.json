        {"id": "hotwell_makeup", "type": "LinePanel", "x": 141, "y": 8, "width": 125, "height": 96, "title": "HW MAKEUP", "lines": [{"type": "value", "label": "FLOW", "value": {"provider": "reference.hotwell_makeup_pump", "path": "lastFlow"}, "decimals": 0, "unit": "/s"}]},
        {"id": "deaerator", "type": "LinePanel", "x": 274, "y": 8, "width": 125, "height": 96, "title": "DEAERATOR", "lines": [{"type": "value", "label": "LEVEL", "value": {"provider": "reference.main_deaerator", "path": "levelPercent"}, "decimals": 0, "unit": "%"}]},
        {"id": "hotwell", "type": "LinePanel", "x": 407, "y": 8, "width": 125, "height": 96, "title": "HOTWELL", "lines": [{"type": "value", "label": "LEVEL", "value": {"provider": "reference.hotwell", "path": "levelPercent"}, "decimals": 0, "unit": "%"}]},
        {"id": "cw_pump", "type": "LinePanel", "x": 8, "y": 112, "width": 125, "height": 96, "title": "CW PUMP", "lines": [{"type": "value", "label": "FLOW", "value": {"provider": "reference.circulating_water_pump_a1", "path": "lastFlow"}, "decimals": 0, "unit": "/s"}]},
        {"id": "cw_makeup", "type": "LinePanel", "x": 141, "y": 112, "width": 125, "height": 96, "title": "CW MAKEUP", "lines": [{"type": "value", "label": "FLOW", "value": {"provider": "reference.cooling_water_makeup_pump", "path": "lastFlow"}, "decimals": 0, "unit": "/s"}]},
        {"id": "cw_loop", "type": "LinePanel", "x": 274, "y": 112, "width": 125, "height": 96, "title": "CW LOOP", "lines": [{"type": "value", "label": "TEMP", "value": {"provider": "reference.cooling_water", "path": "temperature"}, "decimals": 0, "unit": "C"}]},
