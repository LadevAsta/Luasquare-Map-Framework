        {"id": "hotwell_drain", "type": "LinePanel", "x": 185, "y": 216, "width": 170, "height": 96, "title": "HOTWELL DRAIN", "lines": [{"type": "value", "label": "FLOW", "value": {"provider": "reference.hotwell_drain_valve", "path": "lastFlow"}, "decimals": 0, "unit": "/s"}]},
        {"id": "recirc_drain", "type": "LinePanel", "x": 362, "y": 216, "width": 170, "height": 96, "title": "RECIRC DRAIN", "lines": [{"type": "value", "label": "FLOW", "value": {"provider": "reference.recirc_drain_valve", "path": "lastFlow"}, "decimals": 0, "unit": "/s"}]}
